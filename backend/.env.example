# Copy this file to backend/.env and fill in your own values.
# Never commit the real backend/.env file.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string-of-at-least-50-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# React dev server origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (the database must already exist, see README)
POSTGRES_DB=berryloop
POSTGRES_USER=berryloop
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
